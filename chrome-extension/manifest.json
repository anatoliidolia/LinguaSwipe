{
  "manifest_version": 3,
  "name": "LinguaSwipe — додати слово",
  "short_name": "LinguaSwipe",
  "version": "1.0.0",
  "description": "Виділіть англійське слово на будь-якій сторінці, введіть переклад — і воно потрапить у ваш словник LinguaSwipe.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LinguaSwipe",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
