# Скопіюйте у .env.local (не комітиться) для локального запуску.
# На GitHub Pages ці значення беруться зі змінних репозиторію SUPABASE_URL і SUPABASE_KEY.
# Лише публічний anon / publishable ключ — НІКОЛИ не service_role / secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your-anon-key
